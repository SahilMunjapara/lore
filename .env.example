# Local Docker: leave as is. FalkorDB Cloud: paste your instance's host, port and credentials.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# One graph per company/tenant.
LORE_GRAPH=lore

# Optional: raises the GitHub API limit from 60 to 5,000 requests/hour (public data only).
GITHUB_TOKEN=
